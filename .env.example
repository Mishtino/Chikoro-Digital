APP_NAME=Chikoro Digital API
ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./chikoro.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PAYNOW_RETURN_URL=http://localhost:3000/paynow/return
PAYNOW_RESULT_URL=http://localhost:8000/paynow/webhook

# Optional one-time bootstrap for a fresh installation only.
# Set both as private deployment secrets, never commit actual values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
